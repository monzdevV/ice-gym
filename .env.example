# Copia este archivo a .env.local y rellena los valores.
# Mismo proyecto de Supabase que la web.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Dirección de la web pública para los enlaces "Web pública".
NEXT_PUBLIC_WEB_URL=http://localhost:3210
# Sólo servidor (NUNCA con prefijo NEXT_PUBLIC_): permite a RRHH crear cuentas del CRM,
# cambiar contraseñas, bloquear accesos de bajas y entrar con nombre de usuario.
# Supabase → Project Settings → API Keys → service_role / secret.
SUPABASE_SERVICE_ROLE_KEY=
