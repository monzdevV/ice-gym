# Copia este archivo a .env.local y rellena los valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional: dirección de la web pública si vive en otro dominio (por defecto, la landing de este proyecto en "/").
NEXT_PUBLIC_WEB_URL=
# Sólo servidor (NUNCA con prefijo NEXT_PUBLIC_): permite a RRHH crear cuentas del CRM,
# cambiar contraseñas, bloquear accesos de bajas y entrar con nombre de usuario.
# Supabase → Project Settings → API Keys → service_role / secret.
SUPABASE_SERVICE_ROLE_KEY=

# Lector de facturas del CRM (API de Claude). Solo servidor: nunca NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
