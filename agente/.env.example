# Copia este archivo a .env y rellena los valores. El .env no se sube a Git.

# 1. Modelo: Claude vía OpenRouter (https://openrouter.ai/keys).
#    Cambiar de modelo es cambiar este nombre; comprueba que existe en openrouter.ai/models.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# 2. Supabase: el mismo proyecto que el CRM (Project Settings -> API Keys).
#    Usa la clave PUBLICABLE (sb_publishable_...). Nunca service_role ni sb_secret_...
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 3. Usuario del CRM con el que entra el agente (rol authenticated).
#    Créalo en Supabase -> Authentication -> Users; mejor uno sólo para el agente.
CRM_EMAIL=agente@tuempresa.es
CRM_PASSWORD=cambia-esto

# 4. Carpeta de facturas en el disco del servidor (opcional; por defecto ./facturas).
#    Dentro van las subcarpetas Proveedores, Suministros, Gastos-viaje… (no uses una llamada «crm»).
# FACTURAS_CARPETA=/srv/facturas
