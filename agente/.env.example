# Copia este archivo a .env y rellena los valores.

# Modelo: Claude vía OpenRouter. Cambiar de modelo es cambiar este nombre.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Supabase: el mismo proyecto que el CRM, con la clave publicable (NUNCA service_role).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Usuario del CRM con el que entra el agente (rol authenticated).
CRM_EMAIL=agente@tuempresa.es
CRM_PASSWORD=cambia-esto

# Carpeta de facturas en el disco del servidor (opcional; por defecto ./facturas).
# FACTURAS_CARPETA=/srv/facturas
